# ---------------------------------------------------------------------------
# Vision 2.0 configuration
# Copy this file to `.env` and edit what you need. Every value is optional;
# the defaults below are what Vision uses when the variable is absent.
# `VISION_`-prefixed names are also accepted (e.g. VISION_OLLAMA_MODEL).
# ---------------------------------------------------------------------------

# ---- Identity / local AI --------------------------------------------------
ASSISTANT_NAME=Vision
CREATOR_NAME=Taha
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT=60
OLLAMA_RETRIES=2

# ---- Voice output ---------------------------------------------------------
# edge = natural neural voice (needs internet) | native = OS voice | none
TTS_ENGINE=edge
EDGE_VOICE=en-US-ChristopherNeural
EDGE_RATE=-12%
EDGE_PITCH=-18Hz
EDGE_VOLUME=+50%
PLAY_VOLUME=2.5
# Metallic "Ultron" effect via sox (Linux/macOS; install sox first)
SOX_EFFECT=true
# Native fallback voice name (macOS "Ralph", Windows SAPI name, espeak voice)
NATIVE_VOICE=
NATIVE_RATE=150

# ---- Voice input ----------------------------------------------------------
# auto = Google when online, Vosk when configured/offline
# google | vosk | text
STT_ENGINE=auto
STT_LANGUAGE=en-IN
PREFER_OFFLINE_STT=false
# Path to an extracted Vosk model, e.g. .../vosk-model-small-en-us-0.15
VOSK_MODEL_PATH=
MICROPHONE_ENABLED=true
# Optional device index (leave empty for the system default)
MICROPHONE_DEVICE=
CALIBRATION_INTERVAL=120
WAKE_LISTEN_TIMEOUT=4
WAKE_PHRASE_TIME=3
COMMAND_LISTEN_TIMEOUT=4
COMMAND_PHRASE_TIME=8
MAX_AUDIO_FAILURES=3

# ---- Double-clap activation ----------------------------------------------
CLAP_ENABLED=true
# Lower if claps are missed, raise if Vision triggers on its own
CLAP_THRESHOLD=2000
CLAP_MIN_INTERVAL=0.1
CLAP_MAX_INTERVAL=0.8
CLAP_DEBOUNCE=0.05
AUDIO_CHUNK=1024
AUDIO_RATE=44100
AUDIO_CHANNELS=1

# ---- Holographic interface ------------------------------------------------
# Comma-separated flags: --sd (720p), --hd (1080p)
INTERFACE_ARGS=
INTERFACE_TIMEOUT=10

# ---- Wake phrases (comma-separated, lowercase) ----------------------------
WAKE_PHRASES=hey vision,hey visions,a vision,hey vishon,hey vizhan

# ---- Storage / logging ----------------------------------------------------
# Default: platform user-data dir (see README)
DATA_DIR=
LOG_DIR=
MEMORY_DB=
STATE_FILE=
SCREENSHOT_DIR=
PHOTO_DIR=
# Vision 1.2 JSON memory to import once, then renamed to *.migrated
LEGACY_MEMORY_JSON=
LOG_LEVEL=INFO
LOG_MAX_BYTES=1000000
LOG_BACKUPS=5
